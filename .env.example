# HTTP 服务
VRP_HOST=0.0.0.0
VRP_PORT=8000
VRP_LOG_LEVEL=INFO

# 可选 API Key。设置后所有 /api/v1/* 接口都需要 X-API-Key 请求头。
# VRP_API_KEY=change-me

# 限制
VRP_MAX_LOCATIONS=1000
VRP_MAX_VEHICLES=1000
VRP_MAX_TIME_LIMIT_SECONDS=300
VRP_MAX_JOBS=500
VRP_JOB_TTL_SECONDS=3600
VRP_JOB_WORKERS=2

# 可选 OSRM table 服务（需提供 /table/v1/{profile}/...）
# VRP_OSRM_BASE_URL=http://localhost:5000
VRP_OSRM_PROFILE=driving
VRP_OSRM_TIMEOUT_SECONDS=15
